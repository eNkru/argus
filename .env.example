# Argus — anti-detect fetch service configuration

# Bearer tokens accepted on all /v1/* routes. Comma-separated so you can rotate
# or issue one per client. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ARGUS_API_TOKENS=change-me

# Set to true to disable bearer auth entirely (local dev only). Default false.
ARGUS_AUTH_DISABLED=false

# Shared browser concurrency (asyncio semaphore bounding concurrent fetches).
ARGUS_CONCURRENCY=5

# Idle teardown: close the Camoufox browser after this many seconds with no
# fetch activity, so the resident Firefox process tree (~350-500 MB) is absent
# between scrapes on lightly-loaded hosts.
ARGUS_IDLE_TIMEOUT_SECONDS=300

# Per-request navigation timeout, in seconds. Keep below the caller's own
# AbortSignal timeout so the caller owns the outer envelope.
ARGUS_FETCH_TIMEOUT_SECONDS=35

# Post-domcontentloaded SPA render-wait cap, in seconds. Client-rendered SPAs
# inject content via JS after domcontentloaded; this bounds the stability wait.
ARGUS_RENDER_WAIT_SECONDS=8

# Camoufox fingerprint OS. Pin to the OS whose font set is physically present
# in the image (linux, when using the provided Dockerfile which prunes macos/
# windows fonts). A macos/win fingerprint that names fonts which can't resolve
# locally is a fingerprinting tell.
ARGUS_DEFAULT_FINGERPRINT_OS=linux
