# Argus — anti-detect fetch service configuration

# Bearer tokens accepted on all /v1/* routes. Comma-separated so you can rotate
# or issue one per client. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ARGUS_API_TOKENS=change-me

# Set to true to disable bearer auth entirely (local dev only). Default false.
ARGUS_AUTH_DISABLED=false

# Interactive API docs (/docs /redoc /openapi.json). Default false (off in
# production — the schema is not public). dev.sh sets this true so local dev
# keeps /docs (the README references it).
ARGUS_DOCS_ENABLED=false

# Shared browser concurrency (asyncio semaphore bounding concurrent fetches).
ARGUS_CONCURRENCY=5

# Idle teardown: close the Camoufox browser after this many seconds with no
# fetch activity, so the resident Firefox process tree (~350-500 MB) is absent
# between scrapes on lightly-loaded hosts.
ARGUS_IDLE_TIMEOUT_SECONDS=300

# Per-request navigation timeout, in seconds. Keep below the caller's own
# AbortSignal timeout so the caller owns the outer envelope.
ARGUS_FETCH_TIMEOUT_SECONDS=35

# Post-domcontentloaded SPA render-wait cap, in seconds. Client-rendered SPAs
# inject content via JS after domcontentloaded; this bounds the stability wait.
ARGUS_RENDER_WAIT_SECONDS=8

# SSRF guard (security). Fetched URLs whose host is private / loopback /
# link-local / cloud-metadata (169.254.169.254, 127.0.0.1, RFC1918, localhost,
# metadata.google.internal, ...) are blocked — a fetch service must not be an
# SSRF proxy. Default false (BLOCK). Set true ONLY for deployments that
# legitimately scrape internal hosts (operator escape hatch).
ARGUS_FETCH_ALLOW_PRIVATE=false

# Inbound request rate limiting (security). Per-IP fixed-window throttle on
# /v1/* routes, applied BEFORE auth — so the 401 bearer-token brute-force path
# is throttled too. Default OFF (byte-identical behavior until you opt in).
# When enabled, over-limit requests get a 429 + Retry-After; /health is always
# exempt. In-memory and single-process: under multiple workers / a load
# balancer each worker gets its own budget (see src/argus/ratelimit.py).
ARGUS_RATE_LIMIT_ENABLED=false

# Requests allowed per client IP per window. Generous default: a single caller
# at 1 req/s is 60/min, far under 600, so legitimate callers never trip it.
ARGUS_RATE_LIMIT_REQUESTS=600

# Fixed-window length, in seconds.
ARGUS_RATE_LIMIT_WINDOW_S=60

# Camoufox fingerprint OS. Pin to the OS whose font set is physically present
# in the image (linux, when using the provided Dockerfile which prunes macos/
# windows fonts). A macos/win fingerprint that names fonts which can't resolve
# locally is a fingerprinting tell.
ARGUS_DEFAULT_FINGERPRINT_OS=linux

# AI price-extraction fallback (POST /v1/extract-price stage 2).
#
# Generic OpenAI-compatible chat-completions provider used when a page's
# JSON-LD yields no usable price. ALL THREE of BASE_URL + API_KEY + MODEL must
# be non-empty for the LLM stage to exist; leaving any of them empty disables
# the AI stage entirely and /v1/extract-price behaves as a deterministic,
# JSON-LD-only service. The API key is a secret: never logged.
#
# OpenAI-compatible base URL (no trailing /chat/completions), e.g.:
ARGUS_AI_BASE_URL=
# Provider API key (SECRET).
ARGUS_AI_API_KEY=
# Chat model id served at that base URL, e.g. a DeepSeek free-tier model.
ARGUS_AI_MODEL=

# Optional Zen parity headers: when ARGUS_AI_BASE_URL's host equals
# ARGUS_AI_ZEN_HOST, these two ride on every AI request so argus and iris can
# share one free-tier provider's client allowlist. Both optional; empty = off.
ARGUS_AI_ZEN_HOST=
ARGUS_AI_USER_AGENT=
ARGUS_AI_CLIENT_HEADER=

# Throttle: max concurrent LLM calls, minimum gap between calls (ms, live-
# tunable), and retry attempts for transient 429/502/503/504 errors.
# Conservative defaults mirror iris so both services can share a free tier.
ARGUS_AI_CONCURRENCY=1
ARGUS_AI_MIN_INTERVAL_MS=200
ARGUS_AI_MAX_RETRIES=3

# Optional retailer-domain allow-list for the AI fallback stage. Comma-
# separated host suffixes, e.g. "pbtech.co.nz,kogan.co.nz". Empty (default) =
# no restriction, so the AI stage runs exactly as before. When set, the AI
# stage runs only if the fetched page's final hostname matches a listed
# suffix (exact or ".suffix" subdomain, case-insensitive); otherwise it
# degrades to extraction_failed with an INFO log — no LLM call, no cost.
# AI-extracted prices are UNTRUSTED regardless; this only scopes which hosts
# the LLM stage may run on. See security-guidelines.md.
ARGUS_AI_EXTRACT_DOMAIN_ALLOWLIST=
